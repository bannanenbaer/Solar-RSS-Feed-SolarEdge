# SolarEdge API (required)
SOLAREDGE_API_KEY=your_api_key_here
SOLAREDGE_SITE_ID=your_site_id_here

# Location for weather forecast (optional, defaults to Wennigsen)
SOLAR_LAT=52.2762744
SOLAR_LON=9.5671846

# System specs (optional)
SOLAR_PEAK_KW=10.0        # Nennleistung der PV-Anlage in kW
SOLAR_BATTERY_KWH=10.0    # Akku-Kapazitaet in kWh (0 = kein Akku)

# Database path (optional)
SOLAR_DB_PATH=/data/solar.db
